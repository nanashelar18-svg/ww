      }
    },
    {
      "name": "Auth - Login (Admin)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@nexus.ai\",\n  \"password\": \"password123\"\n}"
        },
        "url": "http://localhost:5000/api/auth/login"
      }
    },
    {
